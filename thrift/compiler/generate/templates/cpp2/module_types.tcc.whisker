{{#import "common/fields" as fields}}
{{> Autogen}}
#pragma once

#include "{{program.include_prefix}}{{program.name}}_types.h"

#include <thrift/lib/cpp2/gen/module_types_tcc.h>
{{#if (not (array.empty? program.structured_definitions))}}

namespace {{program.cpp_qualified_namespace}} {
  {{#each program.structured_definitions as |struct|}}
    {{#if (not struct.union?)}}
      {{#if (object.notnull? struct.extra_namespace)}}
namespace {{struct.extra_namespace}} {
      {{/if (object.notnull? struct.extra_namespace)}}
      {{#each struct.fields as |field|}}
template <>
[[FOLLY_ATTR_GNU_NODEBUG]] FOLLY_ERASE const auto& {{struct.cpp_underlying_name}}::__fbthrift_get_field_storage<{{field.id}}>() const {
  return this->{{#partial fields.field_value field=field}};
}
        {{#if field.has_isset?}}
template <>
[[FOLLY_ATTR_GNU_NODEBUG]] FOLLY_ERASE bool {{struct.cpp_underlying_name}}::__fbthrift_get_field_isset<{{field.id}}>() const {
  return this->__isset.get({{field.isset_index}});
}
        {{/if field.has_isset?}}
      {{/each}}
      {{#if (object.notnull? struct.extra_namespace)}}
} // namespace {{struct.extra_namespace}}
      {{/if (object.notnull? struct.extra_namespace)}}
    {{/if (not struct.union?)}}
  {{/each}}
} // namespace {{program.cpp_qualified_namespace}}
{{/if (not (array.empty? program.structured_definitions))}}
{{#if (has_compiler_option? "tablebased")}}

namespace {{program.cpp_qualified_namespace}} {
  {{#each program.structured_definitions as |struct|}}
    {{#if (object.notnull? struct.extra_namespace)}}
namespace {{struct.extra_namespace}} {
    {{/if (object.notnull? struct.extra_namespace)}}
extern const ::apache::thrift::detail::StructInfoN<{{(array.len struct.fields)}}> __fbthrift_struct_info_{{struct.cpp_underlying_name}};
    {{#if (object.notnull? struct.extra_namespace)}}
} // namespace {{struct.extra_namespace}}
    {{/if (object.notnull? struct.extra_namespace)}}
  {{/each}}
} // namespace {{program.cpp_qualified_namespace}}
{{/if (has_compiler_option? "tablebased")}}
