  {{#if (object.notnull? struct.cpp_allocator)}}
  {{struct.cpp_underlying_name}}::{{struct.cpp_underlying_name}}({{struct.cpp_underlying_name}}&& rhs, const allocator_type& alloc)
      : __fbthrift_alloc(alloc),
        fbthrift_type_(folly::to_underlying(Type::__EMPTY__)) {
    switch (rhs.getType()) {
      case Type::__EMPTY__:
        return;
    {{#if struct.fields?}}
      {{#partial module_types.union_move_field_cases struct=struct src="rhs"}}
    {{/if struct.fields?}}
      default:
        assert(false);
    }
  }

  {{/if (object.notnull? struct.cpp_allocator)}}
  {{struct.cpp_underlying_name}}& {{struct.cpp_underlying_name}}::operator=({{struct.cpp_underlying_name}}&& rhs){{#partial module_types.union_move_assign_noexcept struct=struct}} {
    if (this == &rhs) { return *this; }
  {{#if (object.notnull? struct.cpp_allocator)}}
    ::apache::thrift::detail::move_allocator(__fbthrift_alloc, rhs.__fbthrift_alloc);
  {{/if (object.notnull? struct.cpp_allocator)}}
    switch (rhs.getType()) {
      case Type::__EMPTY__:
      {
        __fbthrift_clear();
        return *this;
      }
    {{#if struct.fields?}}
      {{#partial module_types.union_move_field_cases struct=struct src="rhs"}}
    {{/if struct.fields?}}
      default:
      {
        assert(false);
        __fbthrift_clear();
      }
    }
    return *this;
  }

