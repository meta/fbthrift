    {{/if (object.notnull? struct.cpp_allocator)}}
  {{struct.cpp_underlying_name}}& {{struct.cpp_underlying_name}}::operator=(const {{struct.cpp_underlying_name}}& rhs) {
    {{! a bunch of code relies on the self-assignment check even though it should not be needed }}
    if (this == &rhs) { return *this; }
    {{! Copy into a new union first, because `rhs` may live inside `*this`. }}
    {{#if (object.notnull? struct.cpp_allocator)}}
    allocator_type alloc = __fbthrift_alloc;
    ::apache::thrift::detail::copy_allocator(alloc, rhs.__fbthrift_alloc);
    {{struct.cpp_underlying_name}} copy(rhs, alloc);
    __fbthrift_clear();
    ::apache::thrift::detail::copy_allocator(__fbthrift_alloc, rhs.__fbthrift_alloc);
    return *this = std::move(copy);
    {{#else}}
    return *this = {{struct.cpp_underlying_name}}(rhs);
    {{/if (object.notnull? struct.cpp_allocator)}}
  }
  {{/if (not struct.cpp_noncopyable)}}

