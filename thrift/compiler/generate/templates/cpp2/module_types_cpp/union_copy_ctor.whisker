    {{#if (object.notnull? struct.cpp_allocator)}}
  {{struct.cpp_underlying_name}}::{{struct.cpp_underlying_name}}(const {{struct.cpp_underlying_name}}& rhs, const allocator_type& alloc)
      : __fbthrift_alloc(alloc),
        fbthrift_type_(folly::to_underlying(Type::__EMPTY__)) {
    switch (rhs.getType()) {
      case Type::__EMPTY__:
