{{#import "common/types" as types}}

{{! Defines the mapping of a thrift type to the Java RpcPayloadUtil field constant. }}
{{#let export partial rpc_field_type |type|}}
  {{#pragma ignore-newlines}}
{{#if type.string_or_binary?}}com.facebook.thrift.util.RpcPayloadUtil.STRING_FIELD
{{#else if type.bool?}}com.facebook.thrift.util.RpcPayloadUtil.BOOL_FIELD
{{#else if type.byte?}}com.facebook.thrift.util.RpcPayloadUtil.BYTE_FIELD
{{#else if type.i16?}}com.facebook.thrift.util.RpcPayloadUtil.I16_FIELD
{{#else if type.i32?}}com.facebook.thrift.util.RpcPayloadUtil.I32_FIELD
{{#else if type.i64?}}com.facebook.thrift.util.RpcPayloadUtil.I64_FIELD
{{#else if type.double?}}com.facebook.thrift.util.RpcPayloadUtil.DOUBLE_FIELD
{{#else if type.float?}}com.facebook.thrift.util.RpcPayloadUtil.FLOAT_FIELD
{{#else if type.enum?}}com.facebook.thrift.util.RpcPayloadUtil.I32_FIELD
{{#else if type.structured?}}com.facebook.thrift.util.RpcPayloadUtil.STRUCT_FIELD
{{#else if type.list?}}com.facebook.thrift.util.RpcPayloadUtil.LIST_FIELD
{{#else if type.set?}}com.facebook.thrift.util.RpcPayloadUtil.SET_FIELD
{{#else if type.map?}}com.facebook.thrift.util.RpcPayloadUtil.MAP_FIELD
{{/if type.string_or_binary?}}
{{/let partial}}

{{! Writes a Thrift value to the protocol for response/sink types.
    Takes a type object and a depth integer (suffix for _fbthriftVar variables).
    The top-level call site passes depth=0, meaning the value is in _fbthriftVar0.
    Recurses into containers, incrementing depth for each nesting level. }}
{{#let export partial write_response_type |type depth| captures |types|}}
{{#if type.typedef?}}{{!
}}{{#partial write_response_type type=type.resolved depth=depth}}{{!
}}{{#else if type.set?}}oprot.writeSetBegin(new TSet(TType.{{#partial types.ttype type=type.elem_type}}, _fbthriftVar{{depth}}.size()));
for ({{#partial types.java_type type=type.elem_type has_adapter_override=false}} _fbthriftVar{{(int.add depth 1)}} : _fbthriftVar{{depth}}) {
  {{#partial write_response_type type=type.elem_type depth=(int.add depth 1)}}
}
oprot.writeSetEnd();
{{#else if type.list?}}oprot.writeListBegin(new TList(TType.{{#partial types.ttype type=type.elem_type}}, _fbthriftVar{{depth}}.size()));
for ({{#partial types.java_type type=type.elem_type has_adapter_override=false}} _fbthriftVar{{(int.add depth 1)}} : _fbthriftVar{{depth}}) {
  {{#partial write_response_type type=type.elem_type depth=(int.add depth 1)}}
}
oprot.writeListEnd();
{{#else if type.map?}}oprot.writeMapBegin(new TMap(TType.{{#partial types.ttype type=type.key_type}}, TType.{{#partial types.ttype type=type.val_type}}, _fbthriftVar{{depth}}.size()));
for (Map.Entry<{{#partial types.boxed_type type=type.key_type field_hasAdapter=false}}, {{#partial types.boxed_type type=type.val_type field_hasAdapter=false}}> _fbthriftVar{{(int.add depth 1)}} : _fbthriftVar{{depth}}.entrySet()) {
  {
    {{#partial types.boxed_type type=type.key_type field_hasAdapter=false}} _fbthriftVar{{(int.add depth 2)}} = _fbthriftVar{{(int.add depth 1)}}.getKey();
    {{#partial write_response_type type=type.key_type depth=(int.add depth 2)}}
  }
  {
    {{#partial types.boxed_type type=type.val_type field_hasAdapter=false}} _fbthriftVar{{(int.add depth 2)}} = _fbthriftVar{{(int.add depth 1)}}.getValue();
    {{#partial write_response_type type=type.val_type depth=(int.add depth 2)}}
  }
}
oprot.writeMapEnd();
{{#else if type.structured?}}_fbthriftVar{{depth}}.write0(oprot);
{{#else if type.enum?}}oprot.writeI32(_fbthriftVar{{depth}} == null ? 0 : _fbthriftVar{{depth}}.getValue());
{{#else if type.binary?}}{{!
}}{{#if (not type.java_type?)}}oprot.writeBinary(java.nio.ByteBuffer.wrap(_fbthriftVar{{depth}}));
{{#else}}oprot.writeBinary(_fbthriftVar{{depth}});
{{/if (not type.java_type?)}}{{!
}}{{#else if type.string?}}oprot.writeString(_fbthriftVar{{depth}});
{{#else if type.bool?}}oprot.writeBool(_fbthriftVar{{depth}});
{{#else if type.byte?}}oprot.writeByte(_fbthriftVar{{depth}});
{{#else if type.i16?}}oprot.writeI16(_fbthriftVar{{depth}});
{{#else if type.i32?}}oprot.writeI32(_fbthriftVar{{depth}});
{{#else if type.i64?}}oprot.writeI64(_fbthriftVar{{depth}});
{{#else if type.float?}}oprot.writeFloat(_fbthriftVar{{depth}});
{{#else if type.double?}}oprot.writeDouble(_fbthriftVar{{depth}});
  {{/if type.typedef?}}{{!
}}{{/let partial}}

{{! Sizes a Thrift value for response/sink writers, mirroring write_response_type branch for
    branch. Takes a type object and a depth integer. Adds the value size to the `_fbthriftSize` long
    accumulator with max(Binary, Compact worst case) widths, so no protocol calls are needed. }}
{{#let export partial size_response_type |type depth| captures |types|}}
  {{#if type.typedef?}}{{!
}}{{#if (or type.isBinaryString? (and type.java_type? type.binary?))}}    {{#if (int.lt? depth 2)}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.binary(_fbthriftVar{{depth}});
    {{#else}}
_fbthriftSize +=
    com.facebook.thrift.util.ThriftSizes.binary(
        _fbthriftVar{{depth}});
    {{/if (int.lt? depth 2)}}
{{#else}}{{#partial size_response_type type=type.resolved depth=depth}}{{!
}}{{/if (or type.isBinaryString? (and type.java_type? type.binary?))}}
{{#else if type.set?}}{{#if (or type.elem_type.bool? type.elem_type.byte? type.elem_type.i16? type.elem_type.i32? type.elem_type.i64? type.elem_type.float? type.elem_type.double? type.elem_type.enum?)}}{{! collections of fixed-width primitives avoid looping }}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.SET;
    {{#if (int.lt? depth 2)}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size() * {{#partial types.fixed_width type=type.elem_type}};
    {{#else}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size()
        * {{#partial types.fixed_width type=type.elem_type}};
    {{/if (int.lt? depth 2)}}
    {{#else}}_fbthriftSize += com.facebook.thrift.util.ThriftSizes.SET;
for ({{#partial types.java_type type=type.elem_type has_adapter_override=false}} _fbthriftVar{{(int.add depth 1)}} :
    _fbthriftVar{{depth}}) {
    {{#partial size_response_type type=type.elem_type depth=(int.add depth 1)}}
}
    {{/if (or type.elem_type.bool? type.elem_type.byte? type.elem_type.i16? type.elem_type.i32? type.elem_type.i64? type.elem_type.float? type.elem_type.double? type.elem_type.enum?)}}
  {{#else if type.list?}}    {{#if (or type.elem_type.bool? type.elem_type.byte? type.elem_type.i16? type.elem_type.i32? type.elem_type.i64? type.elem_type.float? type.elem_type.double? type.elem_type.enum?)}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.LIST;
    {{#if (int.lt? depth 2)}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size() * {{#partial types.fixed_width type=type.elem_type}};
    {{#else}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size()
        * {{#partial types.fixed_width type=type.elem_type}};
    {{/if (int.lt? depth 2)}}
    {{#else}}_fbthriftSize += com.facebook.thrift.util.ThriftSizes.LIST;
for ({{#partial types.java_type type=type.elem_type has_adapter_override=false}} _fbthriftVar{{(int.add depth 1)}} :
    _fbthriftVar{{depth}}) {
    {{#partial size_response_type type=type.elem_type depth=(int.add depth 1)}}
}
    {{/if (or type.elem_type.bool? type.elem_type.byte? type.elem_type.i16? type.elem_type.i32? type.elem_type.i64? type.elem_type.float? type.elem_type.double? type.elem_type.enum?)}}
  {{#else if type.map?}}    {{#if (and (or type.key_type.bool? type.key_type.byte? type.key_type.i16? type.key_type.i32? type.key_type.i64? type.key_type.float? type.key_type.double? type.key_type.enum?) (or type.val_type.bool? type.val_type.byte? type.val_type.i16? type.val_type.i32? type.val_type.i64? type.val_type.float? type.val_type.double? type.val_type.enum?))}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.MAP;
_fbthriftSize += (long) _fbthriftVar{{depth}}.size() * {{#partial types.fixed_width type=type.key_type}};
_fbthriftSize += (long) _fbthriftVar{{depth}}.size() * {{#partial types.fixed_width type=type.val_type}};
    {{#else}}_fbthriftSize += com.facebook.thrift.util.ThriftSizes.MAP;
      {{#if (or type.key_type.bool? type.key_type.byte? type.key_type.i16? type.key_type.i32? type.key_type.i64? type.key_type.float? type.key_type.double? type.key_type.enum?)}}
    {{#if (int.lt? depth 2)}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size() * {{#partial types.fixed_width type=type.key_type}};
    {{#else}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size()
        * {{#partial types.fixed_width type=type.key_type}};
    {{/if (int.lt? depth 2)}}
      {{/if (or type.key_type.bool? type.key_type.byte? type.key_type.i16? type.key_type.i32? type.key_type.i64? type.key_type.float? type.key_type.double? type.key_type.enum?)}}
      {{#if (or type.val_type.bool? type.val_type.byte? type.val_type.i16? type.val_type.i32? type.val_type.i64? type.val_type.float? type.val_type.double? type.val_type.enum?)}}
    {{#if (int.lt? depth 2)}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size() * {{#partial types.fixed_width type=type.val_type}};
    {{#else}}
_fbthriftSize +=
    (long) _fbthriftVar{{depth}}.size()
        * {{#partial types.fixed_width type=type.val_type}};
    {{/if (int.lt? depth 2)}}
      {{/if (or type.val_type.bool? type.val_type.byte? type.val_type.i16? type.val_type.i32? type.val_type.i64? type.val_type.float? type.val_type.double? type.val_type.enum?)}}
for (Map.Entry<{{#partial types.boxed_type type=type.key_type field_hasAdapter=false}}, {{#partial types.boxed_type type=type.val_type field_hasAdapter=false}}> _fbthriftVar{{(int.add depth 1)}} :
    _fbthriftVar{{depth}}.entrySet()) {
      {{#if (or type.key_type.bool? type.key_type.byte? type.key_type.i16? type.key_type.i32? type.key_type.i64? type.key_type.float? type.key_type.double? type.key_type.enum?)}}
      {{#else}}
    {
        {{#partial types.boxed_type type=type.key_type field_hasAdapter=false}} _fbthriftVar{{(int.add depth 2)}} =
            _fbthriftVar{{(int.add depth 1)}}.getKey();
        {{#partial size_response_type type=type.key_type depth=(int.add depth 2)}}
    }
      {{/if (or type.key_type.bool? type.key_type.byte? type.key_type.i16? type.key_type.i32? type.key_type.i64? type.key_type.float? type.key_type.double? type.key_type.enum?)}}
      {{#if (or type.val_type.bool? type.val_type.byte? type.val_type.i16? type.val_type.i32? type.val_type.i64? type.val_type.float? type.val_type.double? type.val_type.enum?)}}
      {{#else}}
    {
        {{#partial types.boxed_type type=type.val_type field_hasAdapter=false}} _fbthriftVar{{(int.add depth 2)}} =
            _fbthriftVar{{(int.add depth 1)}}.getValue();
        {{#partial size_response_type type=type.val_type depth=(int.add depth 2)}}
    }
      {{/if (or type.val_type.bool? type.val_type.byte? type.val_type.i16? type.val_type.i32? type.val_type.i64? type.val_type.float? type.val_type.double? type.val_type.enum?)}}
}
    {{/if (and (or type.key_type.bool? type.key_type.byte? type.key_type.i16? type.key_type.i32? type.key_type.i64? type.key_type.float? type.key_type.double? type.key_type.enum?) (or type.val_type.bool? type.val_type.byte? type.val_type.i16? type.val_type.i32? type.val_type.i64? type.val_type.float? type.val_type.double? type.val_type.enum?))}}
{{#else if type.structured?}}{
    long _fbthriftSize{{depth}} =
