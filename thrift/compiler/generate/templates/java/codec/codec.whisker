{{#else if type.enum?}}    {{#if (int.lt? depth 2)}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.ENUM;
    {{#else}}
_fbthriftSize +=
    com.facebook.thrift.util.ThriftSizes.ENUM;
    {{/if (int.lt? depth 2)}}
{{#else if type.binary?}}{{!
}}{{#if (not type.java_type?)}}    {{#if (int.lt? depth 2)}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.binary(_fbthriftVar{{depth}}.length);
    {{#else}}
_fbthriftSize +=
    com.facebook.thrift.util.ThriftSizes.binary(
        _fbthriftVar{{depth}}.length);
    {{/if (int.lt? depth 2)}}
{{#else}}    {{#if (int.lt? depth 2)}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.binary(_fbthriftVar{{depth}});
