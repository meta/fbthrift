{{! Sizes one response value for a response/sink writer sizeHint: the field header, the value and
    the stop, clamped. Fixed-width values return the constant directly, without declaring a local;
    anything else is sized with size_response_type. `from_response` selects the `_r` value (request
   /response writers) over the `_o` value (stream/sink factories). }}
{{#let export partial response_size_body |type from_response| captures |types size_response_type|}}
{{#if (or type.bool? type.byte? type.i16? type.i32? type.i64? type.float? type.double? type.enum?)}}
return com.facebook.thrift.util.ThriftSizes.FIELD
    + {{#partial types.fixed_width type=type}}
    + com.facebook.thrift.util.ThriftSizes.FIELD_STOP;
{{#else}}
{{#partial types.java_type type=type has_adapter_override=false}} _fbthriftVar0 = ({{#partial types.java_type type=type has_adapter_override=false}}) {{#if from_response}}_r{{#else}}_o{{/if from_response}};
long _fbthriftSize = com.facebook.thrift.util.ThriftSizes.FIELD;
{{#partial size_response_type type=type depth=0}}
_fbthriftSize += com.facebook.thrift.util.ThriftSizes.FIELD_STOP;
return com.facebook.thrift.util.ThriftSizes.clampToInt(_fbthriftSize);
{{/if (or type.bool? type.byte? type.i16? type.i32? type.i64? type.float? type.double? type.enum?)}}
{{/let partial}}
