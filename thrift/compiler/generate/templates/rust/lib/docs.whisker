{{!
  Docs for a definition, shown by editors on hover, if it has any. A Thrift
  definition in them is a code block so that rustdoc neither runs it as a
  doctest nor reads its `<...>` as HTML.
}}
{{#let export partial docblock |node|}}
  {{#let text = (node.docblock code_fence="thrift")}}
  {{#if (not (string.empty? text))}}
{{text}}
  {{/if (not (string.empty? text))}}
{{/let partial}}
