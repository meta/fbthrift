#
# CMake package configuration file for find_package(FBThrift), the names an
# older Thrift installed.
#
# Finds the thrift package, then adds FBThrift::<name> targets that forward to
# the thrift:: ones, FBTHRIFT_COMPILER and FBTHRIFT_INCLUDE_DIR.

include("@thrift_config_dir@/thrift-config.cmake")
if (NOT ${_thrift_package}_FOUND)
  return()
endif()

# Adds FBThrift::<legacy> for each <legacy>:<name> pair whose thrift::<name>
# exists. A function, so its variables stay out of the consumer's scope;
# function names are global, hence the prefix.
function(_thrift_add_legacy_targets)
  foreach(entry IN LISTS ARGN)
    string(REPLACE ":" ";" names "${entry}")
    list(GET names 0 legacy)
    list(GET names 1 name)
    if (TARGET FBThrift::${legacy} OR NOT TARGET thrift::${name})
      continue()
    endif()
    get_target_property(type thrift::${name} TYPE)
    if (type STREQUAL "EXECUTABLE")
      # An imported executable can't forward to another target, so copy what
      # COMMAND and $<TARGET_FILE:...> read.
      add_executable(FBThrift::${legacy} IMPORTED)
      get_target_property(configs thrift::${name} IMPORTED_CONFIGURATIONS)
      if (configs)
        set_target_properties(FBThrift::${legacy}
                              PROPERTIES IMPORTED_CONFIGURATIONS "${configs}")
      endif()
      foreach(suffix IN LISTS configs ITEMS "")
        if (suffix)
          set(suffix "_${suffix}")
        endif()
        get_target_property(location thrift::${name} IMPORTED_LOCATION${suffix})
        if (location)
          set_target_properties(FBThrift::${legacy}
                                PROPERTIES IMPORTED_LOCATION${suffix} "${location}")
        endif()
      endforeach()
    else()
      add_library(FBThrift::${legacy} INTERFACE IMPORTED)
      target_link_libraries(FBThrift::${legacy} INTERFACE thrift::${name})
    endif()
  endforeach()
endfunction()

_thrift_add_legacy_targets(@thrift_legacy_names@)

# thrift-cpp, the RPC libraries together, has no thrift:: name.
if (TARGET thrift::async AND NOT TARGET FBThrift::thrift-cpp)
  add_library(FBThrift::thrift-cpp INTERFACE IMPORTED)
  target_link_libraries(FBThrift::thrift-cpp INTERFACE thrift::async
      thrift::concurrency thrift::protocol thrift::transport)
endif()

if (TARGET thrift::compiler)
  get_target_property(FBTHRIFT_COMPILER thrift::compiler LOCATION)
else()
  set(FBTHRIFT_COMPILER "FBTHRIFT_COMPILER-NOTFOUND")
endif()
set(FBTHRIFT_INCLUDE_DIR "${THRIFT_INCLUDE_DIR}")
