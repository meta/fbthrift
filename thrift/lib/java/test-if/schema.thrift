include "thrift/annotation/thrift.thrift"
include "thrift/annotation/java.thrift"
include "thrift/lib/java/test-if/size_alias.thrift"

@thrift.AllowLegacyMissingUris
package;

namespace java.swift com.facebook.thrift.test

struct EveryLayout {
  1: bool aBool;
  2: i32 aInt;
  3: i64 aLong;
  5: string aString;
  6: double aDouble;
  7: float aFloat;
  8: i16 aShort;
  9: byte aByte;
  10: list<string> aList;
  11: set<string> aSet;
  12: map<i32, string> aMap;
  13: list<list<string>> aListOfLists;
  14: set<set<string>> aSetOfSets;
  15: map<list<i32>, list<i32>> aMapOfLists;
  16: binary aBinary;
  17: map<set<i32>, i32> aMapOfSets;
}

struct JustABinary {
  1: binary aBinary;
}

struct Pet {
  1: string name;
  2: optional i32 age;
  3: optional bool vegan;
}

struct Nested1 {
  1: list<Pet> pets;
}

struct Nested2 {
  1: map<i32, Nested1> nests;
}

union TestUnion {
  1: Pet thePet;
  2: Pet theOtherPet;
  3: EveryLayout allThings;
  4: JustABinary aBinary;
}

struct ThriftSizes {
  1: i32 value;
}

// Fixed-bound structs nest by value: the outer bound folds the inner bound.
struct NestedLeaf {
  1: i64 x;
}

struct NestedMid {
  1: i64 x;
  2: NestedLeaf leaf;
}

// Containers of a fixed-bound struct with a nested bound struct size without
// traversal: the fold must include the inner bound.
struct NestedMidList {
  1: list<NestedMid> items;
}

struct NestedMidMap {
  1: map<i32, NestedMid> items;
}

// An optional fixed-bound struct field is absent from the fold: the size walk
// counts it only when set. The plain field rides the fold; the optional one
// must not be lost. The alias proves a typedef of a bound struct resolves to
// the struct, not the alias, when sizing.
typedef OptionalBoundLeaf LeafAlias

// Cross-file typedef: the struct lives in size_alias.thrift under another
// Java package, so sizing must resolve the true type, not the alias.
typedef size_alias.CrossLeaf CrossLeafAlias

struct OptionalBoundLeaf {
  1: i64 v;
}

struct OptionalBoundHolder {
  1: i32 a;
  2: optional OptionalBoundLeaf leaf;
  3: OptionalBoundLeaf plain;
  4: optional LeafAlias aliasLeaf;
  5: optional CrossLeafAlias crossLeaf;
}

// A directly recursive struct has no fixed bound: the cycle must terminate
// the bound analysis instead of recursing forever. Sizing recurses at runtime.
struct RecursiveSizeStruct {
  1: i32 x;
  @java.Recursive
  2: RecursiveSizeStruct next;
}

// A mutual reference pair likewise has no fixed bound on either side.
struct MutualSizeA {
  1: i32 x;
  @java.Recursive
  2: MutualSizeB b;
}

struct MutualSizeB {
  1: i32 y;
  @java.Recursive
  2: MutualSizeA a;
}

